# Copy to .env.prod on the server and fill in, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# Never commit the real .env.prod — same rule as backend/.env.

# Postgres — pick a real password, not this placeholder.
POSTGRES_USER=ditto
POSTGRES_PASSWORD=replace-with-a-real-password
POSTGRES_DB=ditto_prod

# Signs the app's own JWTs (backend/src/modules/auth/auth.module.ts) —
# generate with `openssl rand -base64 48` or similar, not hand-typed.
JWT_SECRET=

# Firebase Auth — see backend/.env.example for where these come from.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Anthropic Claude — powers POST /styling/recommend. Optional: the
# backend degrades to a clean 503 on that one endpoint without it.
ANTHROPIC_API_KEY=

# Stripe Connect — powers POST /payments/*. Optional: those endpoints
# 503 cleanly without it. STRIPE_WEBHOOK_SECRET comes from registering
# https://${API_DOMAIN}/payments/webhook as an endpoint in the Stripe
# dashboard once STRIPE_SECRET_KEY is live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Real domains this server answers to, DNS A/AAAA records already
# pointed at this machine's IP before first boot — Caddy requests a
# Let's Encrypt certificate for each on startup and that fails loudly
# if the DNS isn't live yet.
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=you@example.com
