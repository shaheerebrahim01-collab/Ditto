# Local dev — copy to .env and fill in
DATABASE_URL="postgresql://ditto:ditto@localhost:5432/ditto_dev"
PORT=3000
JWT_SECRET="replace-with-a-real-secret"

# Wired and live once you provide these — Firebase (Phase 3):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Anthropic Claude — powers POST /styling/recommend (Phase 8):
# ANTHROPIC_API_KEY=

# Stripe Connect — powers POST /payments/* (Phase 10). Needs a Connect
# platform (not just a plain Stripe account) since Ditto pays out to
# tailors and rental shops, not just charges customers.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Wired in later phases — listed here now so the shape is never a surprise:
# AWS_S3_BUCKET=                # Phase 11
# CLOUDINARY_URL=               # Phase 11
